# Copy this file to .env and fill in the values before starting the server.
# Never commit .env to git.

# Port to listen on (default: 5000)
PORT=5000

# Admin passcode — required to call any mutating tournament API.
# Change this before each event. Do not use the default in production.
ADMIN_PASSCODE=cybernauts2026

# Comma-separated list of allowed CORS origins.
# In production set this to your actual LAN origins, e.g.:
#   ALLOWED_ORIGINS=http://192.168.1.10:3000,http://localhost:3000
# Leaving this blank in development defaults to permissive (*).
ALLOWED_ORIGINS=

# Set to "production" to enforce strict CORS and require ADMIN_PASSCODE.
NODE_ENV=development
